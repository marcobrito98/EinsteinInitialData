##############################################################################
#
# brilldata.par
#
# Simple Brill wave data of the Holz et.al. type
#
##############################################################################

ActiveThorns = "time boundary iobasic ellbase ellsor idbrilldata pugh pughreduce pughslab einstein cartgrid3d ioutil ioascii"

# General

driver::global_nx 				= 32     
driver::global_ny 				= 32     
driver::global_nz 				= 32     

grid::type 					= "byspacing"
grid::dxyz 					= 0.2
grid::domain 					= "octant" 

cactus::cctk_itlast 				= 0

# Brill wave initial data

Einstein::initial_data 				= "brilldata"

# Brill wave parameters

idbrilldata::brill_q 				= 2
idbrilldata::brill_a 				= 1.0

# Elliptic solver.

idbrilldata::brill_solver 			= "sor"
idbrilldata::brill_thresh			= 0.001

ellsor::maxit					= 1000
ellsor::sor_bound				= "robin"

# Output.

IO::out_every = 1

IOASCII::out1D_vars = "einstein::gxx einstein::gyy einstein::gzz einstein::gxy einstein::gxz einstein::gyz idbrilldata::brillpsi"

IOBasic::outScalar_vars = "einstein::gxx einstein::gyy einstein::gzz einstein::gxy einstein::gxz einstein::gyz idbrilldata::brillpsi"
