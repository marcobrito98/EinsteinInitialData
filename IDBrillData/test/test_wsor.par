!DESC "Brill wave initial data (Physical, SOR)"

ActiveThorns = "admbase staticconformal ellbase ellsor boundary pugh pughslab pughreduce CartGrid3D CoordBase idbrilldata ioascii iobasic ioutil time"

# General

driver::global_nx 				= 35
driver::global_ny 				= 35
driver::global_nz 				= 35

grid::type 					= "byspacing"
grid::dxyz 					= 0.2
grid::domain 					= "octant"

cactus::cctk_itlast 				= 0

# Brill wave initial data

ADMBase::initial_data 				= "brilldata2D"
ADMBase::metric_type				= "physical"

# Brill wave parameters

idbrilldata::q_function 			= "gundlach"	
idbrilldata::gundlach_a 			= 5.0

# Elliptic solver.

idbrilldata::solver 				= "sor"
idbrilldata::bound               		= "robin"
idbrilldata::sor_maxit				= 100
# Warning -- since this doesn't converge for so few iterations, the
# result will depend on number of cpus, even beyond the sor tolerance
# level.

# Output.

IO::out_dir       = "test_wsor"
IO::out_fileinfo = "none"
IO::parfile_write = "no"

IOBasic::outInfo_every = 1
IOBasic::outInfo_vars  = "idbrilldata::brillpsi"

IOBasic::outScalar_every = 1
IOBasic::outScalar_vars = "admbase::gxx admbase::gyy admbase::gzz admbase::gxy idbrilldata::brillpsi"

IOASCII::out1D_every = 1
IOASCII::out1D_vars = "admbase::gxx admbase::gyy admbase::gzz admbase::gxy idbrilldata::brillpsi"

IO::new_filename_scheme = "no"

