: :: "Positive or negative"
} 0.0

REAL co_bh1y "y coord of black hole 1"
{
: :: "Positive or negative"
} 0.0

REAL co_bh1z "z coord of black hole 1"
{
: :: "Positive or negative"
} 0.0

