        IsolatedHorizon::ih_multipole_moments
        IsolatedHorizon::ih_3determinant
        IsolatedHorizon::ih_fluxes
"

IO::out_yline_x = 6.0
IO::out_zline_x = 6.0
IOASCII::out1D_every = 1
IOASCII::out1D_vars  = "
        grid::coordinates
        SpaceMask::emask
