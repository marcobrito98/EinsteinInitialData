ActiveThorns = "CarpetIOHDF5"

IOHDF5::out_criterion = time
IOHDF5::out_dt        = 0.8
IOHDF5::out_vars      = "
        SpaceMask::emask
        ADM_BSSN::ADM_BSSN_phi
        ADM_BSSN::ADM_BSSN_metric
        ADM_BSSN::ADM_BSSN_K
        ADM_BSSN::ADM_BSSN_curv
