#########################################################
!DESC "Standing linearised plane wave along y-line, ADM, ICN"
#########################################################

# Required thorns
ActiveThorns = "time ADMconstraints pugh cartgrid3d admbase staticconformal admcoupling admmacros boundary coordgauge pughslab spacemask ADM IDLinearWaves
 ioascii ioutil iobasic pughreduce"

# GENERAL 

driver::global_nx  =  3
driver::global_ny  =  3
driver::global_nz  =  200
time::dtfac    =  0.25   

grid::type         =  "byspacing"
grid::dxyz         =  0.01
grid::domain       =  "full"
grid::avoid_origin = no

cactus::cctk_initial_time  =  0.     
cactus::cctk_itlast        =  100      


# Einstein 

admbase::initial_data     = "standing_planewaves"
admbase::evolution_method = "ADM"     

adm::method        =  "icn" 
adm::bound         =  "static"
admbase::lapse_evolution_method  =  "geodesic"  

# IDLinearwaves
idlinearwaves::amplitude  = 0.001

# Output

IO::outdir         = "test_spw_ADM_icn"
IOBasic::outScalar_every =  10      
IOBasic::outScalar_vars  = "admbase::gzz admbase::kzz 
	admconstraints::ADMconstraints 
	admbase::alp"
IOASCII::out1D_every =  10      
IOASCII::out1D_vars  = "admbase::gxx admbase::gxy admbase::gxz
                        admbase::gyy admbase::gyz admbase::gzz
                        admbase::kxx admbase::kxy admbase::kxz
                        admbase::kyy admbase::kyz admbase::kzz"


IOBasic::outInfo_every = 5
IOBasic::outInfo_vars = "admconstraints::ham admbase::gzz"

##################################################################
